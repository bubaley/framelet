# Required: generate with openssl rand -hex 32
FRAMELET_API_TOKEN=
# Pin a release version for reproducible deployments, e.g. 0.1.0.
FRAMELET_IMAGE_TAG=latest
FRAMELET_BIND_ADDRESS=127.0.0.1
FRAMELET_PORT=8000

# Optional service limits (defaults shown)
FRAMELET_MAX_VIDEO_BYTES=20971520
FRAMELET_MAX_FRAME_PIXELS=16777216
FRAMELET_MAX_FRAME_BYTES=67108864
FRAMELET_MAX_INTERMEDIATE_BYTES=67108864
FRAMELET_UPLOAD_TIMEOUT_SECONDS=30
FRAMELET_RENDER_TIMEOUT_SECONDS=15
FRAMELET_STARTUP_TIMEOUT_SECONDS=30
